{
  "type": "object",
  "additionalProperties": false,
  "required": ["po_number", "customer", "currency", "lines", "requested_date", "priority"],
  "properties": {
    "po_number": { "type": "string", "pattern": "^PO-\\d{5}$" },
    "customer": { "type": "string", "minLength": 2 },
    "currency": { "type": "string", "enum": ["USD", "EUR", "GBP"] },
    "requested_date": { "type": "string", "format": "date" },
    "priority": { "type": "string", "enum": ["standard", "expedite"] },
    "contact_email": { "type": "string", "format": "email" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sku", "qty", "unit_price"],
        "properties": {
          "sku": { "type": "string", "pattern": "^[A-Z]{3}-\\d{3,4}$" },
          "qty": { "type": "integer", "minimum": 1 },
          "unit_price": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
